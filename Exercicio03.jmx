  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Exercicio 3 - Testando diferentes paginas" enabled="true">
      <stringProp name="TestPlan.comments">Sem assertions de proposito: o codigo de cada resposta aparece no Results Tree/Table (404 e 500 sao esperados no httpbin).</stringProp>
